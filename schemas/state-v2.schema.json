{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "revision", "project", "title", "summary", "profiles", "records", "frontier"],
  "properties": {
    "version": {"const": 2, "type": "integer"},
    "revision": {"type": "integer", "minimum": 0},
    "title": {"$ref": "#/$defs/text"},
    "summary": {"type": "string"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "project": {"$ref": "#/$defs/id"},
    "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}},
    "frontier": {"$ref": "#/$defs/ids", "maxItems": 3}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?!\\n)"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "text": {"type": "string", "pattern": "\\S"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "text", "dimensions", "refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["evidence", "decision", "assumption", "risk", "question", "contradiction", "preference"]},
        "status": {"type": "string"},
        "text": {"$ref": "#/$defs/text"},
        "dimensions": {"$ref": "#/$defs/ids"},
        "refs": {"$ref": "#/$defs/ids"},
        "source": {"$ref": "#/$defs/text"},
        "blocking": {"type": "boolean"},
        "resolution": {"$ref": "#/$defs/text"},
        "depends_on": {"$ref": "#/$defs/ids"},
        "deferred": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "evidence"}}},
          "then": {"required": ["source"], "properties": {"status": {"const": "recorded"}, "refs": {"maxItems": 0}}},
          "else": {"properties": {"source": false}}
        },
        {
          "if": {"properties": {"kind": {"const": "decision"}}},
          "then": {"properties": {"status": {"enum": ["proposed", "confirmed", "reopened", "superseded"]}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["assumption", "risk", "question", "contradiction"]}}},
          "then": {"properties": {"status": {"enum": ["open", "resolved"]}}}
        },
        {
          "if": {"properties": {"kind": {"enum": ["risk", "question"]}}},
          "then": {"required": ["blocking"]},
          "else": {"properties": {"blocking": false}}
        },
        {
          "if": {"properties": {"status": {"enum": ["resolved", "superseded"]}}},
          "then": {"required": ["resolution"]},
          "else": {"properties": {"resolution": false}}
        },
        {
          "if": {"properties": {"kind": {"const": "question"}}},
          "then": {"required": ["depends_on"]},
          "else": {"properties": {"depends_on": false}}
        },
        {
          "if": {"properties": {"kind": {"const": "question"}, "status": {"const": "open"}}},
          "else": {"properties": {"deferred": false}}
        },
        {
          "if": {"properties": {"kind": {"const": "preference"}}},
          "then": {"properties": {"status": {"const": "recorded"}}}
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "required", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "question": {"$ref": "#/$defs/text"},
        "required": {"type": "boolean"},
        "source": {"$ref": "#/$defs/id"}
      }
    },
    "unresolved_dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "required", "source", "unresolved_tags"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "question": {"$ref": "#/$defs/text"},
        "required": {"type": "boolean"},
        "source": {"$ref": "#/$defs/id"},
        "unresolved_tags": {"$ref": "#/$defs/ids", "minItems": 1}
      }
    },
    "unresolved_overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unresolved_tags"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "unresolved_tags": {"$ref": "#/$defs/ids", "minItems": 1}}
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "secondary_products",
        "tags",
        "absent_tags",
        "overlays",
        "unresolved_overlays",
        "inapplicable_overlays",
        "dimensions",
        "unresolved_dimensions",
        "inapplicable_dimensions",
        "template_versions",
        "confirmed_by"
      ],
      "properties": {
        "product": {"$ref": "#/$defs/id"},
        "secondary_products": {"$ref": "#/$defs/ids"},
        "tags": {"$ref": "#/$defs/ids"},
        "absent_tags": {"$ref": "#/$defs/ids"},
        "overlays": {"$ref": "#/$defs/ids"},
        "unresolved_overlays": {"type": "array", "items": {"$ref": "#/$defs/unresolved_overlay"}},
        "inapplicable_overlays": {"$ref": "#/$defs/ids"},
        "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}},
        "unresolved_dimensions": {"type": "array", "items": {"$ref": "#/$defs/unresolved_dimension"}},
        "inapplicable_dimensions": {"type": "array", "items": {"$ref": "#/$defs/dimension"}},
        "template_versions": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": ["integer", "null"], "minimum": 1}
        },
        "confirmed_by": {"$ref": "#/$defs/ids"}
      }
    }
  }
}
