{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "id", "dimensions"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer", "const": 1},
    "id": {"$ref": "#/$defs/id"},
    "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}},
    "tags": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "applies": {"$ref": "#/$defs/rule"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?!\\n)"},
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "question": {"type": "string", "pattern": "\\S"},
        "required": {"type": "boolean"},
        "applies": {"$ref": "#/$defs/rule"}
      }
    },
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
    "rule": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "product": {"$ref": "#/$defs/id"},
        "tag": {"$ref": "#/$defs/id"},
        "all": {"$ref": "#/$defs/rules"},
        "any": {"$ref": "#/$defs/rules"},
        "not": {"$ref": "#/$defs/rule"}
      }
    }
  }
}
